{
  "expo": {
    "name": "CodeForge Mobile",
    "slug": "codeforge-mobile",
    "scheme": "codeforge",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "android": {
      "package": "com.codeforge.mobile",
      "permissions": ["INTERNET"]
    },
    "ios": { "bundleIdentifier": "com.codeforge.mobile" }
  }
}